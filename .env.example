# Application Configuration
API_TITLE=BiteRoute API
API_VERSION=v1
API_V1_PREFIX=/api/v1
DEBUG=false

# Database Configuration
# Default local SQLite for instant local development:
DATABASE_URL=sqlite:///./biteroute.db
# PostgreSQL async connection (Production / Testing):
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/biteroute

# Rate Limiting Configuration (In-Memory IP Limiter)
RATE_LIMIT=100/minute
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_INACTIVE_TTL_SECONDS=120

# Pagination Defaults and Limits
DEFAULT_LIMIT=20
MAX_LIMIT=100
